  "timeline": [
    {
      "version": "0.15",
      "pr": 34,
      "title": "Libreria GUI",
      "detail": "Record e selettori ordinari, layout column/row, controlli nativi, state e transizioni immutabili. Ricostruzione del sottoalbero con ripristino del focus."
    },
    {
      "version": "0.16",
      "pr": 35,
      "title": "DOM incrementale e stato indipendente",
      "detail": "Identità per posizione e tipo, validazione prima del commit, callback correnti, stato figlio preservato, chiave esplicita per reset. Nessun riordino keyed."
    },
    {
      "version": "0.17",
      "pr": 36,
      "title": "Stili componibili e griglia",
      "detail": "Decoratori senza wrapper, record di stile validati, aggiornamento delle sole proprietà cambiate. Benchmark sintetico di allocazioni e scritture CSS."
    },
    {
      "version": "0.18",
      "pr": 37,
      "title": "DOM Performance Lab",
      "detail": "Misure Chromium reale: sola view, incrementale, ricostruzione, DOM diretto; carico sparso e denso, con e senza layout forzato."
    },
    {
      "version": "0.19",
      "pr": 38,
      "title": "Specializzazione delle view fisse",
      "detail": "Pass separato sull'AST risolto: estrae slot testuali, ricompila le espressioni con Mira, monta via renderer generico e aggiorna i nodi senza attraversare l'albero. Le versioni 0.17–0.19 sono integrate cumulativamente."
    },
    {
      "version": "0.20",
      "pr": 39,
      "title": "Record e stili dinamici",
      "detail": "Accessi ai campi e condizioni; validazione CSS condivisa; tutti gli slot validati prima delle scritture. Forma delle decorazioni fissa."
    },
    {
      "version": "0.21",
      "pr": 41,
      "title": "Binding dei controlli",
      "detail": "Input, checkbox, select a opzioni statiche; transizioni chiuse, gestione eventi e IME comune; verifica focus e cursore in Chromium, rollback e reset."
    },
    {
      "version": "0.22",
      "pr": 42,
      "title": "Componenti componibili",
      "detail": "Espansione lessicale dei selettori ordinari e costanti di dati letterali; la libreria GUI reale viene inclusa nel form. Dashboard e scheda lezione canoniche testate senza riscriverne le view."
    }
  ],
