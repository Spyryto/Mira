# Mira 0.4: built-in record accessors + native comparisons/conditional.
# Only map, filter and count remain host-provided.
id = field "id";
title = field "title";
purpose = field "purpose";
produces = field "produces";
source files = field "sourceFiles";
path = field "path";
group field = field "group";
language = field "language";
lines = field "lines";
imports = field "imports";
name = field "name";
kind = field "kind";
parameters = field "parameters";
body tokens = field "bodyTokens";
line = field "line";
phases = field "phases";
module list = field "modules";
edges = field "edges";

stage card: stage = {
  id: (stage ~ id),
  title: (stage ~ title),
  purpose: (stage ~ purpose),
  produces: (stage ~ produces),
  sourceFiles: (stage ~ source files)
};

module card: module = {
  id: (module ~ id),
  title: (module ~ title),
  path: (module ~ path),
  group: (module ~ group field),
  language: (module ~ language),
  lines: (module ~ lines),
  dependencies: (count: (module ~ imports))
};

declaration card: declaration = {
  name: (declaration ~ name),
  kind: (declaration ~ kind),
  line: (declaration ~ line),
  parameters: (declaration ~ parameters),
  tokens: (count: (declaration ~ body tokens))
};

ast card: node = {
  name: (node ~ name),
  kind: (node ~ kind),
  line: (node ~ line)
};

atlas stages: stages = map: stages, with: (stage card: _);
atlas modules: modules = map: modules, with: (module card: _);
atlas declarations: definitions = map: definitions, with: (declaration card: _);
atlas ast: definitions = map: definitions, with: (ast card: _);

module matches: module, group: expected = (module ~ group field) == expected;

atlas select modules: modules, group: requested =
  if: (requested == "Tutti"),
  then: (modules),
  else: (filter: modules, with: (module matches: _, group: (requested)));

atlas overview: dataset = {
  stages: (count: (dataset ~ phases)),
  modules: (count: (dataset ~ module list)),
  dependencies: (count: (dataset ~ edges))
};
