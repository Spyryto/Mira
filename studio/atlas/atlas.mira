# Atlas is precompiled during CI. Host only supplies record access, map and count.
# All record projections and the overview structure are authored in Mira.
stage card: stage = {
  id: (get: "id", from: (stage)),
  title: (get: "title", from: (stage)),
  purpose: (get: "purpose", from: (stage)),
  produces: (get: "produces", from: (stage)),
  sourceFiles: (get: "sourceFiles", from: (stage))
};

module card: module = {
  id: (get: "id", from: (module)),
  title: (get: "title", from: (module)),
  path: (get: "path", from: (module)),
  group: (get: "group", from: (module)),
  language: (get: "language", from: (module)),
  lines: (get: "lines", from: (module)),
  dependencies: (count: (get: "imports", from: (module)))
};

declaration card: declaration = {
  name: (get: "name", from: (declaration)),
  kind: (get: "kind", from: (declaration)),
  line: (get: "line", from: (declaration)),
  parameters: (get: "parameters", from: (declaration)),
  tokens: (count: (get: "bodyTokens", from: (declaration)))
};

ast card: node = {
  name: (get: "name", from: (node)),
  kind: (get: "kind", from: (node)),
  line: (get: "line", from: (node))
};

atlas stages: stages = map: stages, with: (stage card: _);
atlas modules: modules = map: modules, with: (module card: _);
atlas declarations: definitions = map: definitions, with: (declaration card: _);
atlas ast: definitions = map: definitions, with: (ast card: _);

atlas overview: dataset = {
  stages: (count: (get: "phases", from: (dataset))),
  modules: (count: (get: "modules", from: (dataset))),
  dependencies: (count: (get: "edges", from: (dataset)))
};
