# The editor owns policy; the host only supplies a native text operation.
Suggestion :: {label: Text, signature: Text, summary: Text, snippet: Text, origin: Text, first: Text, kind: Text};
editor complete: prefix (Text), from: items ([Suggestion]) -> [Suggestion] =
  select: items, with: {item (Suggestion) | starts with: prefix, in: (item ~ first)};
editor lookup: name (Text), from: items ([Suggestion]) -> [Suggestion] =
  select: items, with: {item (Suggestion) | (item ~ label == name) OR (item ~ first == name)};
editor tooltip: item (Suggestion) -> {title: Text, detail: Text, description: Text, provenance: Text} =
  {title: item ~ label, detail: item ~ signature, description: item ~ summary, provenance: item ~ origin};

# The host normalizes the compiler schema; Mira owns field selection and tooltip semantics.
Record Field :: {receiver: Text, field: Text, signature: Text, optional: Boolean};
editor fields: receiver (Text), prefix: prefix (Text), from: fields ([Record Field]) -> [Record Field] =
  select: fields, with: {field (Record Field) |
    (field ~ receiver == receiver) AND (NOT (field ~ optional)) AND
    (starts with: prefix, in: (field ~ field))};
editor field lookup: receiver (Text), name: name (Text), from: fields ([Record Field]) -> [Record Field] =
  select: fields, with: {field (Record Field) |
    (field ~ receiver == receiver) AND (field ~ field == name)};
editor field tooltip: field (Record Field) -> Suggestion =
  {label: field ~ field, signature: field ~ signature,
   summary: (if: (field ~ optional), then: ("Campo opzionale: può essere assente."), else: ("Campo verificato dal compilatore.")),
   snippet: "", origin: "Tipo del record verificato", first: field ~ field, kind: "property"};

# Parameter names are semantic data from the AST, never parsed from type text.
Signature Parameter :: {selector: Text, name: Text, type: Text};
Signature Part :: {text: Text, role: Text};
editor parameter parts: parameter (Signature Parameter) -> [Signature Part] =
  [{text: parameter ~ selector, role: "selector"},
   {text: ": ", role: "selector"},
   {text: parameter ~ name, role: "parameter"},
   {text: (if: (parameter ~ type == ""), then: (""), else: (if: (parameter ~ name == ""), then: ("("), else: (" ("))), role: "type"},
   {text: parameter ~ type, role: "type"},
   {text: (if: (parameter ~ type == ""), then: (""), else: (")")), role: "type"}];
editor signature: parameters ([Signature Parameter]), returning: result (Text) -> {parameters: [[Signature Part]], result: Text} =
  {parameters: (collect: parameters, with: {parameter (Signature Parameter) | editor parameter parts: parameter}), result: result};
