# The editable arithmetic subset is a flat, immutable node table.
# The browser adapter allocates IDs and owns input, history and DOM.
Case :: {tag: Text, param: Text, type: Text, root: Number};
Node :: {id: Number, kind: Text, text: Text, left: Number, right: Number, cases: [Case]};

projection replace: replacement (Node), in: nodes ([Node]) -> [Node] =
  collect: nodes, with: {node (Node) |
    if: ((node ~ id) == (replacement ~ id)),
    then: (replacement), else: (node)
  };

projection wrap: replacement (Node), left: previous (Node), right: hole (Node), in: nodes ([Node]) -> [Node] =
  append: hole, to: (append: previous, to:
    (projection replace: replacement, in: nodes));
