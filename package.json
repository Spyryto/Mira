{
  "name": "mira-discursive",
  "private": true,
  "version": "0.61.0",
  "type": "module",
  "description": "Mira discursive syntax frontend: Haxe source, JS/PHP emitters",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && npm run build:studio && node --test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "test:studio": "npm run build:studio && node --test test/studio.test.mjs",
    "docs": "node scripts/generate-reference.mjs && node scripts/generate-documentation-origin.mjs",
    "docs:check": "node scripts/generate-documentation-origin.mjs --check",
    "benchmark:atlas": "npm run build:studio && node scripts/benchmark-atlas.mjs",
    "benchmark:gui": "npm run build:studio && node --test --test-name-pattern='synthetic GUI benchmark' test/ui-host.test.mjs",
    "build:fullstack": "npm run build:studio && node scripts/build-fullstack.mjs",
    "test:fullstack": "npm run build:studio && node --test test/fullstack.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
